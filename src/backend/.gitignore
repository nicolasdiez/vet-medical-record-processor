# backend/.gitignore

# Ignore all env files
.env*

# Ignore real clinical PDFs in fixtures
src/backend/tests/fixtures/*.pdf

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables
.env
.env.local

# SQLite database (for local MVP)
*.sqlite3
*.db

# OS generated files
.DS_Store
Thumbs.db

# Project specific (uploaded files)
uploads/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Allow environment variables template
!.env.example